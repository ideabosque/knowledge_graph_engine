# =============================================================================
# Knowledge Graph Engine - Integration Test Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials to version control.
# =============================================================================

# --- AWS Configuration ---
region_name=us-east-1
aws_access_key_id=your_aws_access_key_id
aws_secret_access_key=your_aws_secret_access_key

# --- Tenant Partition ---
# endpoint_id and part_id together form the partition_key ({endpoint_id}#{part_id})
# used for tenant isolation across Neo4j instances and DynamoDB tables.
endpoint_id=your_endpoint_id
part_id=your_part_id

# --- LLM Configuration ---
# llm_type: "openai", "anthropic", "ollama", "vertexai", "mistralai"
# llm_name: model name for the chosen provider
# llm_model_params: optional JSON dict merged into model_params (e.g. temperature)
#
# --- OpenAI (default) ---
llm_type=openai
llm_name=gpt-4o
openai_api_key=your_openai_api_key
# openai_base_url=                   # Optional: custom endpoint (Azure, proxy, etc.)
#
# --- Anthropic ---
# llm_type=anthropic
# llm_name=claude-sonnet-4-20250514
# anthropic_api_key=your_anthropic_api_key
# anthropic_base_url=                # Optional: custom endpoint
#
# --- Ollama (local, no API key needed) ---
# llm_type=ollama
# llm_name=llama3
# ollama_host=http://localhost:11434
#
# --- Vertex AI (uses Google Cloud ADC) ---
# llm_type=vertexai
# llm_name=gemini-1.5-flash-001
# vertexai_system_instruction=       # Optional: system instruction for the model
#
# --- Mistral AI ---
# llm_type=mistralai
# llm_name=mistral-large-latest
# mistralai_api_key=your_mistralai_api_key

# --- Embeddings ---
# embedding_provider defaults to llm_type if not set.
# Supported: "openai" (default), "ollama"
# embedding_provider=openai
embedding_model=text-embedding-3-small
#
# Example: Ollama embeddings (fully local, no OpenAI key needed)
# embedding_provider=ollama
# embedding_model=nomic-embed-text

# --- Neo4j Instance ---
# These are registered via InsertUpdateNeo4jInstance mutation and looked up
# per partition_key at runtime. For local testing, ensure a Neo4j instance
# is registered in the kge-neo4j_instances DynamoDB table.
# neo4j_uri=bolt://localhost:7687
# neo4j_username=neo4j
# neo4j_password=your_neo4j_password
# neo4j_database=neo4j

# --- WooCommerce (for test_woocommerce_extract.py) ---
# pip install woocommerce
# wc_url=https://your-store.com
# wc_consumer_key=ck_your_consumer_key
# wc_consumer_secret=cs_your_consumer_secret

# --- Optional Settings ---
# Set to 1 to auto-create DynamoDB tables on startup (first run only)
initialize_tables=0
# Set to 1 to enable caching
cache_enabled=0
