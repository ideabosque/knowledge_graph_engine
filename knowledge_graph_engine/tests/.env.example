# =============================================================================
# Knowledge Graph Engine - Integration Test Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials to version control.
# =============================================================================

# --- AWS Configuration ---
region_name=us-east-1
aws_access_key_id=your_aws_access_key_id
aws_secret_access_key=your_aws_secret_access_key

# --- Tenant Partition ---
# endpoint_id and part_id together form the partition_key ({endpoint_id}#{part_id})
# used for tenant isolation across Neo4j instances and DynamoDB tables.
endpoint_id=your_endpoint_id
part_id=your_part_id

# --- LLM Configuration ---
# llm_type: "openai", "anthropic", "ollama", "vertexai", "mistralai"
# llm_name: model name for the chosen provider
# llm_model_params: optional JSON dict merged into model_params (e.g. temperature)
#
# --- OpenAI (default) ---
llm_type=openai
llm_name=gpt-4o
openai_api_key=your_openai_api_key
# openai_base_url=                   # Optional: custom endpoint (Azure, proxy, etc.)
#
# --- Anthropic ---
# llm_type=anthropic
# llm_name=claude-sonnet-4-20250514
# anthropic_api_key=your_anthropic_api_key
# anthropic_base_url=                # Optional: custom endpoint
#
# --- Ollama ---
# llm_type=ollama
# llm_name=llama3
# ollama_host=http://localhost:11434
# OLLAMA_API_KEY=                     # Optional: required for remote/hosted Ollama with auth
#
# --- Vertex AI (uses Google Cloud ADC) ---
# llm_type=vertexai
# llm_name=gemini-1.5-flash-001
# vertexai_system_instruction=       # Optional: system instruction for the model
#
# --- Mistral AI ---
# llm_type=mistralai
# llm_name=mistral-large-latest
# mistralai_api_key=your_mistralai_api_key

# --- Embeddings ---
# embedding_provider defaults to llm_type if not set.
# Supported: "openai" (default), "ollama"
# embedding_provider=openai
embedding_model=text-embedding-3-small
#
# embedding_dimensions: vector dimension for the Neo4j vector index.
# Auto-detected from common models (text-embedding-3-small=1536, nomic-embed-text=768,
# mxbai-embed-large=1024, etc.). Set explicitly to override or for unknown models.
# embedding_dimensions=1536
#
# Example: Ollama embeddings
# embedding_provider=ollama
# embedding_model=nomic-embed-text
# OLLAMA_API_KEY is shared with LLM — set it once above

# --- Neo4j Instance ---
# These are registered via InsertUpdateNeo4jInstance mutation and looked up
# per partition_key at runtime. For local testing, ensure a Neo4j instance
# is registered in the kge-neo4j_instances DynamoDB table.
# neo4j_uri=bolt://localhost:7687
# neo4j_username=neo4j
# neo4j_password=your_neo4j_password
# neo4j_database=neo4j

# --- WooCommerce (for test_woocommerce_extract.py) ---
# pip install woocommerce
# wc_url=https://your-store.com
# wc_consumer_key=ck_your_consumer_key
# wc_consumer_secret=cs_your_consumer_secret

# --- Auth Configuration ---
# AUTH_PROVIDER: "local" (default) or "cognito"
AUTH_PROVIDER=local
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP=15                        # Token expiry in minutes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# ADMIN_STATIC_TOKEN=                      # Optional: pre-generated permanent token
# LOCAL_USER_FILE=                          # Optional: path to users.json

# --- Cognito (when AUTH_PROVIDER=cognito) ---
# COGNITO_USER_POOL_ID=us-east-1_xxx
# COGNITO_APP_CLIENT_ID=xxx
# COGNITO_APP_SECRET=xxx
# COGNITO_JWKS_URL=                        # Optional: auto-derived from pool ID

# --- Server ---
PORT=8000
# Number of concurrent background extraction workers (for POST /{endpoint_id}/extract)
# Higher = more parallel LLM calls. Tune based on your OpenAI rate limits.
KGE_EXTRACT_WORKERS=4

# --- Optional Settings ---
# Set to 1 to auto-create DynamoDB tables on startup (first run only)
initialize_tables=0
# Set to 1 to enable caching
cache_enabled=0

# --- Dual-Backend Selection ---
# db_backend: "dynamodb" (default) or "postgresql"
# When set to "postgresql", the PG_* keys below are used and DynamoDB
# table creation is skipped. Neo4j is always required regardless of backend.
db_backend=dynamodb

# --- PostgreSQL connection (used when DB_BACKEND=postgresql) ---------------
# Either DATABASE_URL or the PG_* keys below. When DATABASE_URL is set it wins.
# DATABASE_URL=postgresql+psycopg2://silvaengine:silvaengine@localhost:5432/silvaengine
PG_HOST=localhost
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=silvaengine
PG_DB=silvaengine
# Optional: prefix for all KGE PostgreSQL table and index names (e.g. "kge_").
# Useful when sharing a database with other SilvaEngine modules to avoid
# table-name collisions (e.g. rfq_engine also has a "requests" table).
# When set via env, use PG_TABLE_PREFIX; in settings dict use pg_table_prefix.
# PG_TABLE_PREFIX=kge_
